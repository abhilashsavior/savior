---
import Img from '@/components/Img.astro'
import type { AgencyHeroBrandsBlock as AgencyHeroBrandsBlockType, Media } from 'cms/src/payload-types'

type Props = AgencyHeroBrandsBlockType

const { eyebrow, heading, logos } = Astro.props

const fallbackSizes = [
  { width: 133, height: 55 },
  { width: 133, height: 55 },
  { width: 109, height: 94 },
  { width: 103, height: 74 },
  { width: 88, height: 88 },
  { width: 88, height: 78 },
]

const logoItems = logos
   .map((item, index) => ({
     logo: typeof item.logo === 'object' && item.logo?.filename ? item.logo : null,
     width: item.width ?? fallbackSizes[index]?.width ?? 96,
     height: item.height ?? fallbackSizes[index]?.height ?? 64,
   }))
   .filter((item): item is { logo: Media; width: number; height: number } => item.logo !== null)
---

<section class="bg-agency-forest px-4 py-20 text-white md:px-8 md:py-24 lg:min-h-[647px] lg:px-10 lg:pt-[137px] lg:pb-[147px]">
  <div class="mx-auto flex max-w-[1061px] flex-col items-center">
    <h2 class="w-full max-w-[859px] text-center font-heading text-[29px] leading-[1.25] font-normal tracking-[-0.02em] text-balance md:text-[34px] lg:text-[40px] lg:leading-[1.35]">
      <span class="block">{eyebrow}</span>
      <strong class="block font-bold">{heading}</strong>
    </h2>

    {logoItems.length > 0 && (
      <div class="mt-12 grid grid-cols-2 justify-items-center justify-center gap-3 sm:grid-cols-3 md:mt-14 md:gap-4 lg:mt-[50px] lg:flex lg:w-[1061px] lg:gap-[7px]">
        {
          logoItems.map((item) => (
            <div class="group flex size-[92px] shrink-0 items-center justify-center rounded-full bg-agency-logo-surface md:size-[124px] lg:size-[171px]">
              <Img
                image={item.logo}
                size="original"
                width={item.width}
                height={item.height}
                loading="lazy"
                class="max-h-[55%] max-w-[78%] object-contain opacity-90 grayscale transition-all duration-200 ease-in-out group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-100"
              />
            </div>
          ))
        }
      </div>
    )}
  </div>
</section>
