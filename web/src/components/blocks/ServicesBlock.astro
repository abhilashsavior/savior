---
import Img from '@/components/Img.astro'
import type { ServicesBlock as ServicesBlockType, Media } from 'cms/src/payload-types'

type Props = ServicesBlockType

const { heading, subtitle, services } = Astro.props
const serviceItems = services || []
---

<section class="w-full bg-white py-16 md:py-20 lg:py-[100px]">
  <div class="mx-auto max-w-[1172px] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-[785px] text-center mb-16 lg:mb-[75px]">
      <h2 class="font-heading text-[28px] sm:text-[40px] lg:text-[55px] font-normal leading-[1.22] text-slate-900 mb-4">
        {heading}
      </h2>
      {subtitle && (
        <p class="font-body text-base sm:text-lg text-[#606060]">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-[37px] gap-y-[70px]">
      {serviceItems.map((service, index) => {
        const ctaLink = service.ctaLink && typeof service.ctaLink === 'object' ? (service.ctaLink as any)?.path ?? '#' : '#'

        return (
          <div key={index} class="flex flex-col">
<div class="flex items-center gap-[19px] mb-7">
               {service.icon && typeof service.icon === 'object' && service.icon?.filename && (
                 <Img
                   image={service.icon as Media}
                   size="sm"
                   class="size-[51px] object-contain"
                   loading="lazy"
                 />
               )}
              <h3 class="font-heading text-[18px] sm:text-[20px] lg:text-[22px] font-semibold text-slate-900 leading-[1.27]">
                {service.title}
              </h3>
            </div>

            <div class="h-px w-full bg-gray-200 mb-6"></div>

            <p class="font-body text-base leading-7 text-[#606060] flex-1">
              {service.description}
            </p>

            <a
              href={ctaLink}
              class="mt-6 inline-flex items-center gap-3 text-sm font-bold uppercase tracking-[0.25em] text-black hover:text-primary transition-colors group"
            >
              <span class="flex items-center justify-center size-[38px] rotate-[42deg] transition-transform group-hover:rotate-[42deg]">
                <svg width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 13.5H25M25 13.5L13.5 2M25 13.5L13.5 25" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{service.ctaLabel}</span>
            </a>
          </div>
        )
      })}
    </div>
  </div>
</section>
