---
import type { LoginBlock as LoginBlockType, Media, Page } from 'cms/src/payload-types'
import Img from '@/components/Img.astro'
import Link from '@/components/Link.astro'

type Props = LoginBlockType

const {
  backgroundImage,
  logo,
  title = 'Dashboard',
  titleHighlight = 'Login',
  emailPlaceholder = 'Email Address',
  passwordPlaceholder = 'Password',
  forgotPasswordLabel = 'Forgot password?',
  forgotPasswordLink,
  buttonLabel = 'Login',
  registerLabel = 'register',
  registerIcon,
  registerLink,
} = Astro.props

const forgotPasswordHref = (forgotPasswordLink as Page)?.path ?? '#'
const registerHref = (registerLink as Page)?.path ?? '#'
---

<section class="relative flex min-h-screen w-full flex-col overflow-hidden bg-black">
{
        backgroundImage && typeof backgroundImage === 'object' && backgroundImage?.filename && (
          <div class="absolute inset-0 z-0">
            <Img image={backgroundImage as Media} size="original" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-[#161919] opacity-77" />
          </div>
        )
      }

      {
        !backgroundImage && <div class="absolute inset-0 z-0 bg-black" />
      }

      <div class="relative z-10 flex flex-col min-h-screen">
        <div class="flex items-center justify-between px-10 pt-10">
          {
            logo && typeof logo === 'object' && logo?.filename && (
              <div class="h-[50px] w-[160px]">
                <Img image={logo as Media} size="original" class="h-full w-full object-contain object-left" />
              </div>
            )
          }

          {
            registerLabel && (
              <Link
                path={registerHref}
                class="flex items-center gap-2 capitalize text-sm font-semibold text-white hover:text-[#ef4924] transition-colors"
              >
                {registerIcon && typeof registerIcon === 'object' && registerIcon?.filename && (
                  <span class="h-4 w-4">
                    <Img image={registerIcon as Media} size="thumbnail" class="h-full w-full object-contain invert" />
                  </span>
                )}
                {registerLabel}
              </Link>
            )
          }
    </div>

    <div class="flex flex-1 items-center justify-center px-4">
      <div class="w-full max-w-[620px] space-y-8">
        <h1 class="text-center font-heading text-[40px] leading-[68px] text-white">
          <span class="font-normal">{title}</span>{' '}
          <span class="font-semibold">{titleHighlight}</span>
        </h1>

        <form class="space-y-6" onsubmit="return false">
          <div class="relative">
            <input
              type="email"
              placeholder={emailPlaceholder}
              class="h-[71px] w-full rounded-[50px] border border-white bg-[rgba(0,0,0,0.22)] px-8 text-lg capitalize text-white outline-none placeholder:text-white/60 font-body"
              disabled
            />
          </div>

          <div class="relative">
            <input
              type="password"
              placeholder={passwordPlaceholder}
              class="h-[70px] w-full rounded-[50px] border border-white bg-[rgba(0,0,0,0.22)] px-8 text-lg capitalize text-white outline-none placeholder:text-white/60 font-body"
              disabled
            />
          </div>

          {
            forgotPasswordLabel && (
              <div class="text-right">
                <Link
                  path={forgotPasswordHref}
                  class="text-sm text-[#ccc] capitalize hover:text-white transition-colors font-body"
                >
                  {forgotPasswordLabel}
                </Link>
              </div>
            )
          }

          {
            buttonLabel && (
              <button
                type="submit"
                class="w-full h-[70px] rounded-[50px] bg-[#ef4924] text-[20px] font-semibold uppercase text-white transition-all duration-200 hover:bg-[#d63d1a] active:scale-[0.98] font-body"
                disabled
              >
                {buttonLabel}
              </button>
            )
          }
        </form>
      </div>
    </div>
  </div>
</section>
