---
import Link from '@/components/Link.astro'
import type { SeoServices6Block as SeoServices6BlockType, Page } from 'cms/src/payload-types'

type Props = SeoServices6BlockType

const { heading, headingHighlight, items } = Astro.props
const seoServicesItems = items || []
---

<section class="w-full bg-white py-16 md:py-20 lg:py-[140px]" data-accordion-root>
  <div class="mx-auto max-w-[1795px] px-4 sm:px-6 lg:px-[133px]">
    <h2 class="text-center font-heading text-[28px] sm:text-[40px] lg:text-[55px] font-normal leading-[1.22] text-black mb-12 lg:mb-16">
      <span class="block">{heading}</span>
      <strong class="font-heading font-semibold text-black block">{headingHighlight}<sup class="font-heading font-semibold text-[16px] ml-1 align-super">TM</sup></strong>
    </h2>

    <div class="relative">
      {seoServicesItems.map((item) => {
        const ctaLink = item.ctaButton?.externalUrl || ((item.ctaButton?.link as Page)?.path ?? '#')

        return (
          <div
            class="border-b border-gray-200 first:border-t first:border-gray-200"
            data-accordion-item
            data-expanded={item.isExpanded ? 'true' : 'false'}
          >
            <div class="flex items-start justify-between py-6 lg:py-10 cursor-pointer" data-accordion-trigger>
              <div class="flex items-start gap-6 lg:gap-[80px] flex-1">
                <div class="relative">
                  <span class="font-heading text-[100px] sm:text-[150px] lg:text-[292px] font-medium text-black/5 uppercase leading-none -mt-8 lg:-mt-16 block">
                    {item.number}
                  </span>
                </div>
                <div class="flex-1">
                  <h3 class="font-heading text-lg sm:text-xl lg:text-[22px] font-semibold text-black mb-2 uppercase">
                    {item.title}
                  </h3>
                </div>

                <div class="flex items-start gap-[80px]">
                  <div class="overflow-hidden transition-all duration-300 max-h-0" data-accordion-content>
                    <div class="pb-4">
                      <p class="font-body text-base leading-[28px] text-[#606060] mt-4 lg:mt-0 max-w-[650px]">
                        {item.description}
                      </p>
                      {item.showCta && (
                        <div class="flex flex-col items-start lg:items-center justify-center gap-4 mt-6 lg:mt-8">
                          {item.ctaButton?.label && (
                            <Link
                              path={ctaLink}
                              class="inline-flex items-center justify-center px-10 py-3.75 bg-secrets-accent text-white font-semibold text-sm uppercase tracking-wide rounded-full hover:bg-secrets-accent/90 transition-colors duration-200"
                            >
                              {item.ctaButton.label}
                            </Link>
                          )}
                          <span class="text-sm font-semibold uppercase text-[#606060]">or</span>
                          {item.phoneCta?.phone && (
                            <a
                              href={`tel:${item.phoneCta.phone}`}
                              class="inline-flex items-center gap-[9px]"
                            >
                              <span class="flex items-center justify-center size-[50px] rounded-full border-2 border-black">
                                <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path d="M21.5 16.08V19.5C21.5 19.831 21.3683 20.149 21.1337 20.3837C20.899 20.6183 20.581 20.75 20.25 20.75C17.374 20.432 14.6135 19.4624 12.22 17.93C9.98699 16.5218 8.10545 14.6403 6.69724 12.4073C5.15604 10.0016 4.18585 7.2264 3.878 4.34375C3.86465 4.19511 3.87705 4.04519 3.91454 3.90128C3.95204 3.75736 4.01385 3.62196 4.09683 3.50155C4.17981 3.38113 4.28238 3.27783 4.39924 3.19659C4.5161 3.11536 4.64514 3.05764 4.781 3.02625L8.201 2.28475C8.4668 2.22638 8.74344 2.24446 8.99905 2.33693C9.25466 2.4294 9.47909 2.59232 9.64721 2.80705L11.9242 5.68605C12.2644 6.10935 12.3213 6.69356 12.0722 7.175L10.8792 9.561C12.3125 11.9009 14.2369 13.8254 16.5768 15.2587L18.9628 14.0657C19.4442 13.8166 20.0284 13.8735 20.4517 14.2137L23.3307 16.4907C23.5454 16.6589 23.7084 16.8833 23.8008 17.1389C23.8933 17.3945 23.9114 17.6712 23.853 17.937L23.1115 21.357C22.9784 21.9518 22.6016 22.4549 22.1072 22.757C21.6128 23.059 21.0437 23.1319 20.5 22.9587" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </span>
                              {item.phoneCta.label && <span class="text-sm font-semibold uppercase text-black">{item.phoneCta.label}</span>}
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              <div class="shrink-0">
                <svg
                  class="w-6 h-6 text-black/50 transition-transform duration-300"
                  data-accordion-icon
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 6 15 12 9 18"></polyline>
                </svg>
              </div>
            </div>
          </div>
        )
      })}
    </div>
  </div>
</section>

<script is:inline>
  const initSeoServices6Accordion = () => {
    const root = document.querySelector('[data-accordion-root]')
    if (!root || root.dataset.initialized === 'true') return

    root.querySelectorAll('[data-accordion-item]').forEach((item) => {
      const trigger = item.querySelector('[data-accordion-trigger]')
      const content = item.querySelector('[data-accordion-content]')
      const icon = item.querySelector('[data-accordion-icon]')

      if (!trigger || !content) return

      const isInitiallyExpanded = item.dataset.expanded === 'true'
      if (isInitiallyExpanded) {
        content.style.maxHeight = content.scrollHeight + 'px'
        if (icon) icon.style.transform = 'rotate(90deg)'
      }

      trigger.addEventListener('click', () => {
        const isOpen = item.dataset.expanded === 'true'

        root.querySelectorAll('[data-accordion-item]').forEach((other) => {
          const otherContent = other.querySelector('[data-accordion-content]')
          const otherIcon = other.querySelector('[data-accordion-icon]')
          other.dataset.expanded = 'false'
          if (otherContent) otherContent.style.maxHeight = '0'
          if (otherIcon) otherIcon.style.transform = 'rotate(0deg)'
        })

        if (!isOpen) {
          item.dataset.expanded = 'true'
          content.style.maxHeight = content.scrollHeight + 'px'
          if (icon) icon.style.transform = 'rotate(90deg)'
        }
      })
    })

    root.dataset.initialized = 'true'
  }

  document.addEventListener('astro:page-load', initSeoServices6Accordion)
  initSeoServices6Accordion()
</script>