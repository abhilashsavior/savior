---
import Link from '@/components/Link.astro'
import type { DynamicWordPressBlock as DynamicWordPressBlockType, Media, Page } from 'cms/src/payload-types'

type Props = DynamicWordPressBlockType

const { backgroundImage, heading, boldHeading, description, ctaButton, phoneCta } = Astro.props

const bgUrl = (() => {
  if (backgroundImage && typeof backgroundImage === 'object' && backgroundImage !== null && 'url' in backgroundImage) {
    const url = backgroundImage.url
    if (typeof url === 'string' && url.length > 0) {
      return url
    }
  }
  return undefined
})()

const ctaLink = ctaButton?.externalUrl || ((ctaButton?.link as Page)?.path ?? '#')
---

<section class="relative isolate w-full overflow-hidden bg-[#111716] min-h-[600px] lg:min-h-[788px]">
  {bgUrl && (
    <img src={bgUrl} alt="" class="absolute inset-0 z-0 h-full w-full object-cover" aria-hidden="true" loading="lazy" />
  )}

  <div class="relative z-10 mx-auto flex flex-col items-center justify-center px-6 py-16 md:px-10 md:py-20 lg:px-[327px] lg:py-[139px] text-center">
    <h2 class="font-heading text-[36px] sm:text-[45px] lg:text-[55px] font-normal leading-[1.22] text-white max-w-[909px]">
      {heading}
      {boldHeading && <strong class="font-semibold"> {boldHeading}</strong>}
    </h2>

    {description && (
      <p class="mt-6 font-body text-base sm:text-[18px] leading-[30px] text-white max-w-[909px]">
        {description}
      </p>
    )}

    <div class="mt-9 flex flex-wrap items-center justify-center gap-[17px]">
      {ctaButton?.label && (
        <Link
          path={ctaLink}
          class="get-free-consult-btn"
        >
          {ctaButton.label}
        </Link>
      )}

      <span class="text-sm font-semibold uppercase text-white">or</span>

      {phoneCta?.phone && (
        <a
          href={`tel:${phoneCta.phone}`}
          class="inline-flex items-center gap-[9px] group"
        >
          <span class="flex items-center justify-center size-[50px] rounded-full border border-white">
            <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21.5 16.08V19.5C21.5 19.831 21.3683 20.149 21.1337 20.3837C20.899 20.6183 20.581 20.75 20.25 20.75C17.374 20.432 14.6135 19.4624 12.22 17.93C9.98699 16.5218 8.10545 14.6403 6.69724 12.4073C5.15604 10.0016 4.18585 7.2264 3.878 4.34375C3.86465 4.19511 3.87705 4.04519 3.91454 3.90128C3.95204 3.75736 4.01385 3.62196 4.09683 3.50155C4.17981 3.38113 4.28238 3.27783 4.39924 3.19659C4.5161 3.11536 4.64514 3.05764 4.781 3.02625L8.201 2.28475C8.4668 2.22638 8.74344 2.24446 8.99905 2.33693C9.25466 2.4294 9.47909 2.59232 9.64721 2.80705L11.9242 5.68605C12.2644 6.10935 12.3213 6.69356 12.0722 7.175L10.8792 9.561C12.3125 11.9009 14.2369 13.8254 16.5768 15.2587L18.9628 14.0657C19.4442 13.8166 20.0284 13.8735 20.4517 14.2137L23.3307 16.4907C23.5454 16.6589 23.7084 16.8833 23.8008 17.1389C23.8933 17.3945 23.9114 17.6712 23.853 17.937L23.1115 21.357C22.9784 21.9518 22.6016 22.4549 22.1072 22.757C21.6128 23.059 21.0437 23.1319 20.5 22.9587" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          {phoneCta.label && <span class="text-sm font-semibold uppercase text-white">{phoneCta.label}</span>}
        </a>
      )}
    </div>
  </div>
</section>
