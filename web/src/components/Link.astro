---
import { normalizePath } from '../utils/normalizePath'

type Props = {
  path: string
  class?: string
  normalizePath?: boolean
}

const { preview } = Astro.locals.globalState

const { path, class: className, normalizePath: normalizePathValue = true, ...attrs } = Astro.props
const isInternalCmsPath = path?.startsWith('/') && !path?.startsWith('//')
const href =
  normalizePathValue && isInternalCmsPath ? normalizePath(path, preview) : path
---

<a
  href={href}
  class:list={[
    'inline-flex items-center no-underline transition-all duration-200',
    className,
  ]}
  {...attrs}
>
  <slot />
</a>
