---
import Link from '@/components/Link.astro'
import Img from '@/components/Img.astro'
import { CMS_URL } from 'astro:env/client'
import type { SeoServices2Block as SeoServices2BlockType, Media, Page } from 'cms/src/payload-types'

type Props = SeoServices2BlockType

const { heading, headingHighlight, subheading, items, backgroundImage, ctaButton, phoneCta } = Astro.props
const seoServicesItems = items || []

const bgUrl = (() => {
  if (backgroundImage && typeof backgroundImage === 'object' && backgroundImage !== null && 'url' in backgroundImage) {
    const url = backgroundImage.url
    if (typeof url === 'string' && url.length > 0) {
      return url.startsWith('/') ? `${CMS_URL}${url}` : url
    }
  }
  return undefined
})()

const ctaLink = ctaButton?.externalUrl || ((ctaButton?.link as Page)?.path ?? '#')
---

<section class="w-full bg-secrets-bg relative overflow-hidden py-16 md:py-20 lg:py-[120px]">
  {bgUrl && (
    <img
      src={bgUrl}
      alt=""
      class="absolute inset-0 z-0 h-full w-full object-cover opacity-10"
      aria-hidden="true"
      loading="lazy"
    />
  )}

  <div class="relative mx-auto max-w-[1202px] px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-heading text-[28px] sm:text-[40px] lg:text-[55px] font-normal leading-[1.22] text-white mb-6 lg:mb-8">
      {heading}
      {headingHighlight && (
        <strong class="font-heading font-semibold text-white">{headingHighlight}</strong>
      )}
    </h2>

    {subheading && (
      <p class="text-center font-body text-[18px] sm:text-[20px] lg:text-[20px] font-normal leading-[28px] text-white mb-12 lg:mb-[75px] max-w-[668px] mx-auto">
        {subheading}
      </p>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-[70px] gap-y-[60px] md:gap-y-[100px]">
      {seoServicesItems.map((item) => (
<div class="relative">
           {item.icon && typeof item.icon === 'object' && item.icon?.filename && (
             <Img
               image={item.icon as Media}
               size="sm"
               class="w-12 h-12 mb-4 object-contain"
               loading="lazy"
             />
           )}
          <h3 class="font-heading text-lg sm:text-xl lg:text-[22px] font-semibold text-white mb-2 uppercase">
            {item.title}
          </h3>
          <p class="font-body text-base leading-[28px] text-white">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

{(ctaButton?.label || phoneCta?.phone) && (
  <section class="w-full bg-secrets-accent py-16 md:py-24">
    <div class="mx-auto max-w-[1202px] px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-center lg:flex-row lg:justify-center gap-6">
        {ctaButton?.label && (
          <Link
            path={ctaLink}
            class="inline-flex items-center justify-center px-10 py-3.75 bg-white text-secrets-accent font-semibold text-sm uppercase tracking-wide rounded-full hover:bg-gray-100 transition-colors duration-200"
          >
            {ctaButton.label}
          </Link>
        )}
        <span class="text-sm font-semibold uppercase text-white">or</span>
        {phoneCta?.phone && (
          <a
            href={`tel:${phoneCta.phone}`}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border-2 border-white hover:bg-white/10 transition-colors duration-200"
          >
            <svg width="22" height="22" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21.5 16.08V19.5C21.5 19.831 21.3683 20.149 21.1337 20.3837C20.899 20.6183 20.581 20.75 20.25 20.75C17.374 20.432 14.6135 19.4624 12.22 17.93C9.98699 16.5218 8.10545 14.6403 6.69724 12.4073C5.15604 10.0016 4.18585 7.2264 3.878 4.34375C3.86465 4.19511 3.87705 4.04519 3.91454 3.90128C3.95204 3.75736 4.01385 3.62196 4.09683 3.50155C4.17981 3.38113 4.28238 3.27783 4.39924 3.19659C4.5161 3.11536 4.64514 3.05764 4.781 3.02625L8.201 2.28475C8.4668 2.22638 8.74344 2.24446 8.99905 2.33693C9.25466 2.4294 9.47909 2.59232 9.64721 2.80705L11.9242 5.68605C12.2644 6.10935 12.3213 6.69356 12.0722 7.175L10.8792 9.561C12.3125 11.9009 14.2369 13.8254 16.5768 15.2587L18.9628 14.0657C19.4442 13.8166 20.0284 13.8735 20.4517 14.2137L23.3307 16.4907C23.5454 16.6589 23.7084 16.8833 23.8008 17.1389C23.8933 17.3945 23.9114 17.6712 23.853 17.937L23.1115 21.357C22.9784 21.9518 22.6016 22.4549 22.1072 22.757C21.6128 23.059 21.0437 23.1319 20.5 22.9587" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-semibold uppercase text-white">{phoneCta.label}</span>
          </a>
        )}
      </div>
    </div>
  </section>
)}