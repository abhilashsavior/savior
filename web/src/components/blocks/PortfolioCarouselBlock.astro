---
import Img from '@/components/Img.astro'
import Link from '@/components/Link.astro'
import type { PortfolioCarouselBlock as PortfolioCarouselBlockType, Media, Page } from 'cms/src/payload-types'

type Props = PortfolioCarouselBlockType

const { heading, boldHeading, description, subDescription, ctaButton, phoneCta, projects = [], viewAllLink } = Astro.props
const carouselId = `portfolio-carousel-${Math.random().toString(36).slice(2, 10)}`

const ctaLink = ctaButton?.externalUrl || ((ctaButton?.link as Page)?.path ?? '#')
---

<section class="w-full bg-white py-16 md:py-20 lg:py-24" id={carouselId}>
  <div class="mx-auto max-w-[1923px] px-4 sm:px-6 lg:px-8 xl:px-[40px]">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12 lg:mb-[57px]">
      <div class="max-w-[592px]">
        <h2 class="font-heading text-[28px] sm:text-[40px] lg:text-[55px] font-normal leading-[1.22] text-slate-900">
          {heading}
          {boldHeading && <strong class="font-semibold"> {boldHeading}</strong>}
        </h2>

        <div class="mt-6 flex flex-wrap items-center gap-[17px]">
          {ctaButton?.label && (
            <Link
              path={ctaLink}
              class="inline-flex items-center justify-center px-10 py-3.75 bg-[#ff4d1c] text-white font-semibold text-sm uppercase tracking-wide rounded-full hover:bg-[#e64418] transition-colors duration-200"
            >
              {ctaButton.label}
            </Link>
          )}
          <span class="text-sm font-semibold uppercase text-gray-400">or</span>
          {phoneCta?.phone && (
            <a
              href={`tel:${phoneCta.phone}`}
              class="inline-flex items-center gap-[9px] group"
            >
              <span class="flex items-center justify-center size-[50px] rounded-full border border-black">
                <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21.5 16.08V19.5C21.5 19.831 21.3683 20.149 21.1337 20.3837C20.899 20.6183 20.581 20.75 20.25 20.75C17.374 20.432 14.6135 19.4624 12.22 17.93C9.98699 16.5218 8.10545 14.6403 6.69724 12.4073C5.15604 10.0016 4.18585 7.2264 3.878 4.34375C3.86465 4.19511 3.87705 4.04519 3.91454 3.90128C3.95204 3.75736 4.01385 3.62196 4.09683 3.50155C4.17981 3.38113 4.28238 3.27783 4.39924 3.19659C4.5161 3.11536 4.64514 3.05764 4.781 3.02625L8.201 2.28475C8.4668 2.22638 8.74344 2.24446 8.99905 2.33693C9.25466 2.4294 9.47909 2.59232 9.64721 2.80705L11.9242 5.68605C12.2644 6.10935 12.3213 6.69356 12.0722 7.175L10.8792 9.561C12.3125 11.9009 14.2369 13.8254 16.5768 15.2587L18.9628 14.0657C19.4442 13.8166 20.0284 13.8735 20.4517 14.2137L23.3307 16.4907C23.5454 16.6589 23.7084 16.8833 23.8008 17.1389C23.8933 17.3945 23.9114 17.6712 23.853 17.937L23.1115 21.357C22.9784 21.9518 22.6016 22.4549 22.1072 22.757C21.6128 23.059 21.0437 23.1319 20.5 22.9587" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              {phoneCta.label && <span class="text-sm font-semibold uppercase text-black">{phoneCta.label}</span>}
            </a>
          )}
        </div>
      </div>

      <div class="max-w-[506px]">
        {description && (
          <p class="font-body text-base sm:text-[18px] leading-[30px] text-[#606060] mb-2">
            {description}
          </p>
        )}
        {subDescription && (
          <p class="font-body text-base sm:text-[18px] font-semibold text-black">
            {subDescription}
          </p>
        )}
      </div>
    </div>

    <div class="relative overflow-hidden">
      <div class="flex gap-[36px] transition-transform duration-500 ease-out" data-track>
        {projects.map((project, index) => {
          const hasOverlay = index === 1
          const projectLink = project.link && typeof project.link === 'object' ? (project.link as any)?.path ?? '#' : '#'

          return (
            <div key={index} class="min-w-[366px] shrink-0" data-slide data-index={index}>
              <a
                href={projectLink}
                class="block bg-white border border-[#d9d9d9] group overflow-hidden"
              >
<div class="relative overflow-hidden h-[300px] lg:h-[469px]">
                   {project.image && typeof project.image === 'object' && project.image?.filename && (
                     <Img
                       image={project.image as Media}
                       size="lg"
                       class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                       loading={index === 0 ? 'eager' : 'lazy'}
                     />
                   )}
                 </div>

                {(!index || hasOverlay) && (
                  <div class={hasOverlay ? 'bg-[#161919] px-[25px] py-[34px] pb-[10px]' : 'bg-white px-[25px] py-[34px] pb-[10px]'}>
                    <h3 class={`font-heading text-lg font-semibold uppercase ${hasOverlay ? 'text-white' : 'text-slate-900'}`}>
                      {project.title}
                    </h3>
                    {project.description && (
                      <p class={`font-body text-xs leading-5 mt-1 ${hasOverlay ? 'text-white/65' : 'text-[#606060]'}`}>
                        {project.description}
                      </p>
                    )}
                    {hasOverlay && (
                      <div class="mt-4 flex justify-end">
                        <div class="flex items-center justify-center size-[69px] rounded-full border border-primary rotate-[42deg]">
                          <svg width="33" height="25" viewBox="0 0 35 27" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2 13.5H33M33 13.5L21.5 2M33 13.5L21.5 25" stroke="#ff4d1c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </a>
            </div>
          )
        })}
      </div>
    </div>

    <div class="flex items-center justify-center gap-[526px] mt-8">
      <button
        type="button"
        data-prev
        class="flex items-center justify-center size-[24px] text-gray-400 hover:text-black transition-colors"
        aria-label="Previous project"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="rotate-180">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="flex gap-[17px]">
        {projects.map((_, index) => (
          <button
            key={index}
            type="button"
            data-dot
            data-index={index}
            class={`size-[9px] rounded-full transition-all duration-300 ${index === 0 ? 'bg-[#ef4924] w-[25px] rounded-[5px]' : 'bg-gray-300'}`}
            aria-label={`Go to project ${index + 1}`}
          />
        ))}
      </div>

      <button
        type="button"
        data-next
        class="flex items-center justify-center size-[24px] text-gray-400 hover:text-black transition-colors"
        aria-label="Next project"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {viewAllLink && (
      <div class="text-center mt-8">
        <a
          href={viewAllLink}
          class="font-body text-sm font-semibold uppercase underline underline-offset-4 text-black hover:text-primary transition-colors"
        >
          View All Work
        </a>
      </div>
    )}
  </div>
</section>

<script is:inline>
  const initCarousel = () => {
    const carousel = document.getElementById('${carouselId}')
    if (!carousel || carousel.dataset.initialized === 'true') return

    const track = carousel.querySelector('[data-track]')
    const slides = Array.from(carousel.querySelectorAll('[data-slide]'))
    const dots = Array.from(carousel.querySelectorAll('[data-dot]'))
    const prevButton = carousel.querySelector('[data-prev]')
    const nextButton = carousel.querySelector('[data-next]')

    if (!track || slides.length === 0) return

    let currentIndex = 0

    const updateCarousel = () => {
      const slideWidth = slides[0].offsetWidth + 36
      track.style.transform = `translateX(-${currentIndex * slideWidth}px)`

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('bg-[#ef4924]', 'w-[25px]', 'rounded-[5px]')
          dot.classList.remove('bg-gray-300', 'w-[9px]', 'rounded-full')
        } else {
          dot.classList.remove('bg-[#ef4924]', 'w-[25px]', 'rounded-[5px]')
          dot.classList.add('bg-gray-300', 'w-[9px]', 'rounded-full')
        }
      })
    }

    prevButton?.addEventListener('click', () => {
      currentIndex = Math.max(0, currentIndex - 1)
      updateCarousel()
    })

    nextButton?.addEventListener('click', () => {
      currentIndex = Math.min(slides.length - 1, currentIndex + 1)
      updateCarousel()
    })

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.dataset.index || '0')
        currentIndex = idx
        updateCarousel()
      })
    })

    updateCarousel()
    carousel.dataset.initialized = 'true'
  }

  document.addEventListener('astro:page-load', initCarousel)
  initCarousel()
</script>
