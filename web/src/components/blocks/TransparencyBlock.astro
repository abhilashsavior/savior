---
import Link from '@/components/Link.astro'
import Img from '@/components/Img.astro'
import type { TransparencyBlock as TransparencyBlockType, Media, Page } from 'cms/src/payload-types'

type Props = TransparencyBlockType

const { decorativeImage, features } = Astro.props
const items = features || []
---

<section class="w-full bg-white py-16 md:py-20 lg:py-24 relative overflow-hidden">
  <div class="mx-auto max-w-[1170px] px-4 sm:px-6 lg:px-8">
    {items.map((feature, index) => {
      const ctaLink = feature.ctaButton?.externalUrl || ((feature.ctaButton?.link as Page)?.path ?? '#')
      const showArrow = !feature.showCta

      return (
        <div key={index}>
          <div class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-[46px] py-10 lg:py-[35px] relative">
            <div class="lg:w-[312px] shrink-0">
              <h3
                class="font-heading text-[18px] sm:text-[20px] lg:text-[22px] font-semibold text-black uppercase tracking-[0.08em] leading-[34px]"
              >
                {feature.title}
              </h3>
            </div>

            <div class="flex-1">
              {feature.showCta ? (
                <div class="flex flex-col gap-9">
                  <p class="font-body text-base leading-7 text-[#606060] max-w-[560px]">
                    {feature.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-[17px]">
                    {feature.ctaButton?.label && (
                      <Link
                        path={ctaLink}
                        class="inline-flex items-center justify-center px-10 py-3.75 bg-[#ff4d1c] text-white font-semibold text-sm uppercase tracking-wide rounded-full hover:bg-[#e64418] transition-colors duration-200"
                      >
                        {feature.ctaButton.label}
                      </Link>
                    )}
                    <span class="text-sm font-semibold uppercase text-gray-400">or</span>
                    {feature.phoneCta?.phone && (
                      <a
                        href={`tel:${feature.phoneCta.phone}`}
                        class="inline-flex items-center gap-[9px] group"
                      >
                        <span class="flex items-center justify-center size-[50px] rounded-full border border-black">
                          <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21.5 16.08V19.5C21.5 19.831 21.3683 20.149 21.1337 20.3837C20.899 20.6183 20.581 20.75 20.25 20.75C17.374 20.432 14.6135 19.4624 12.22 17.93C9.98699 16.5218 8.10545 14.6403 6.69724 12.4073C5.15604 10.0016 4.18585 7.2264 3.878 4.34375C3.86465 4.19511 3.87705 4.04519 3.91454 3.90128C3.95204 3.75736 4.01385 3.62196 4.09683 3.50155C4.17981 3.38113 4.28238 3.27783 4.39924 3.19659C4.5161 3.11536 4.64514 3.05764 4.781 3.02625L8.201 2.28475C8.4668 2.22638 8.74344 2.24446 8.99905 2.33693C9.25466 2.4294 9.47909 2.59232 9.64721 2.80705L11.9242 5.68605C12.2644 6.10935 12.3213 6.69356 12.0722 7.175L10.8792 9.561C12.3125 11.9009 14.2369 13.8254 16.5768 15.2587L18.9628 14.0657C19.4442 13.8166 20.0284 13.8735 20.4517 14.2137L23.3307 16.4907C23.5454 16.6589 23.7084 16.8833 23.8008 17.1389C23.8933 17.3945 23.9114 17.6712 23.853 17.937L23.1115 21.357C22.9784 21.9518 22.6016 22.4549 22.1072 22.757C21.6128 23.059 21.0437 23.1319 20.5 22.9587" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        {feature.phoneCta.label && <span class="text-sm font-semibold uppercase text-black">{feature.phoneCta.label}</span>}
                      </a>
                    )}
                  </div>
                </div>
              ) : (
                <div class="flex items-start gap-6 lg:gap-[92px]">
                  <p class="font-body text-base leading-7 text-[#606060] max-w-[652px]">
                    {feature.description}
                  </p>
                  {showArrow && (
                    <div class="hidden lg:flex items-center justify-center shrink-0 size-[144px]">
                      <div class="rotate-[42deg]">
                        <svg width="102" height="102" viewBox="0 0 102 102" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-black">
                          <path d="M2 51H100M100 51L51 2M100 51L51 100" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>

          {index < items.length - 1 && (
            <div class="h-px w-full bg-gray-200"></div>
          )}
        </div>
      )
    })}
  </div>

{decorativeImage && typeof decorativeImage === 'object' && decorativeImage?.filename && (
     <div class="absolute bottom-0 right-0 hidden lg:block pointer-events-none">
       <Img
         image={decorativeImage as Media}
         size="sm"
         class="opacity-50"
         loading="lazy"
       />
     </div>
   )}
 </section>
